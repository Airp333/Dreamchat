<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet">
    <link href="style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=send" />
    <style>
body {
    background: #313338;
    color: #dbdee1;
    margin: 0;
}
#main {
    border: 1px solid #26282c;
    border-radius: 8px;
    margin: 30px;
    background: #313338;
    overflow: hidden;
}
#chat-title {
    text-align: center;
    border-bottom: 1px solid #26282c;
    padding: 16px 20px;
    margin: 0;
    background: #2b2d31;
    color: #f2f3f5;
    font-weight: 700;
    letter-spacing: 0.2px;
}
#input {
    width: 100%;
    background: #383a40;
    border: 1px solid #26282c;
    border-radius: 8px;
    box-sizing: border-box;
    color: #dbdee1;
    padding: 11px 14px;
    font-family: "Ubuntu", sans-serif;
    font-size: 15px;
    outline: none;
}
#input:focus {
    border-color: #383a40;
}
#form {
    display: flex;
    gap: 10px;
    padding: 16px 20px 20px;
    background: #313338;
}
button {
    background: crimson;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    padding: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
}
button:hover {
    background: darkred;
}
h3 {
    padding: 6px 12px;
    margin: 2px 8px;
    border-radius: 6px;
    font-weight: 400;
    font-size: 15px;
    color: #dbdee1;
    transition: background 0.1s ease;
}
h3:hover {
    background: #2e3035;
}
#input::placeholder {
    color: #949ba4;
    opacity: 1;
}
#messages {
    max-height: 400px;
    overflow-y: auto;
    scroll-behavior: smooth;
    padding: 12px 0;
}
#messages::-webkit-scrollbar {
    width: 8px;
}
#messages::-webkit-scrollbar-track {
    background: #2b2d31;
}
#messages::-webkit-scrollbar-thumb {
    background: crimson;
    border-radius: 4px;
}
:lang(en) {
    font-family: "Ubuntu", sans-serif;
}

    </style>
</head>
<body>
    <div id="main">
        <h1 id="chat-title">Hassanpour Empire GC</h1>
        <div id="messages">
            <h3>Airp: sobh doostan zoomji bekheir</h3>
            <h3>ItIsMehrzad: parham prozhe chishod?</h3>
            <h3>Ali: tarjome = glory to benjamin netanyaho and the state of isreal</h3>
            <h3>CreepY: kosmadar tom</h3>
            <h3>Airp: mamot kiretim</h3>
            <% payams.forEach((payam) => { %>
                <h3><%= payam.text %></h3>
            <% }) %>
        </div>
        <form id="form">
            <input id="input" type="text" placeholder="Type a message...">
            <button type="submit">
                <span class="material-symbols-outlined">send</span>
            </button>
        </form>
    </div>
    <script>
        const form = document.getElementById('form');
        const input = document.getElementById('input');
        const messages = document.getElementById('messages');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const text = input.value.trim();
            if (!text) return;

            try {
                const res = await fetch('/messages', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text })
                });

                const data = await res.json();

                if (!res.ok) {
                    console.error(data.error || 'Failed to send message');
                    return;
                }

                const h3 = document.createElement('h3');
                h3.textContent = text;
                messages.appendChild(h3);
                messages.scrollTop = messages.scrollHeight;

                input.value = '';
            } catch (err) {
                console.error(err);
            }
        });
    </script>
</body>
</html>
