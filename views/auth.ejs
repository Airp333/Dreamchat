<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=0.8">
  <title>Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet">
  <style>
  html, body {
    height: 100%;
    margin: 0;
  }
body{
  font-family: "Ubuntu", sans-serif;
  /* background-image: linear-gradient(to right, #A3A3FF 0%, #304352 100%); */
  background-image: linear-gradient(to right, #434343 0%, black 100%);
  /* background-image:  linear-gradient(to right, #d7d2cc 0%, #304352 100%); */
  color: #dbdee1;
  width: 400px;
  margin: auto;
  min-height: 100vh;
}
  input{
    font-family: "Ubuntu", sans-serif;
    display: block;
    margin: auto;
    margin-bottom: 7px;
    background: #383a40;
    border: 1px solid #26282c;
    padding: 10px;
    outline: none;
    color: #dbdee1;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
button{
  font-family: "Ubuntu", sans-serif;
  display: block;
  margin: auto;
  margin-bottom: 5px;
  background: crimson;
  border: none;
  border-radius: 8px;
  color: #ffffff;
  padding: 10px;
  cursor: pointer;
}
button:hover{
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  transform: translateY(-1px);
}
button:active{
  transform: translateY(0) scale(0.96);
}
button:disabled{
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}
  input:focus{
    border-color: rgba(0, 0, 0, 0.35);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.35);
  }
#login-container{
  width: 400px;
  margin: 25px auto;
}
#signup-container{
  width: 400px;
  margin: 25px auto;
}
  h1{
    margin: 0;
    border-bottom: solid 1px rgba(0, 0, 0, 0.2);
    padding: 16px 20px;
    margin-bottom: 15px;
    text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
  }
  p{
  text-align: center;
      text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
  }
  a:link{
    color: darkgrey;
    text-decoration: none;
}
.glass-container {
    background: rgba(0, 0, 0, 0.1);
    color: white;
    backdrop-filter: blur(10px);
    border-radius: 10px;
    border: solid 1px rgba(255, 255, 255, 0.2);
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.05);
    text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
}
input::placeholder{
color:white;
}

h3{
text-align: center;
}

  </style>
</head>
<body>
  <div id="login-container" class="glass-container">
  <h1 class="glass-container"> Login </h1>
  <form id="login-form" action="/login" method="POST">
    <input id="login-username" class="glass-container" type="text" name="username" placeholder="Enter Username" required>
    <input id="login-password" class="glass-container" type="password" name="password" placeholder="Enter password" required>
    <button class="glass-container" type="submit">Login</button>
  </form>
  </div>

  <h3>Or</h3>

  <div id="signup-container" class="glass-container">
  <h1 class="glass-container"> Signup </h1>
  <form id="signup-form" action="/signup" method="POST">
    <input id="signup-username" class="glass-container" type="text" name="username" placeholder="Enter Username" required>
    <input id="signup-password" class="glass-container" type="password" name="password" placeholder="Enter Password" required>
    <input id="signup-password-check" class="glass-container" type="password" name="password-check" placeholder="Check Password" required>
    <button class="glass-container" type="submit">Signup</button>
  </form>
  </div>
<script>
    const loginForm = document.getElementById('login-form');
    const signupForm = document.getElementById('signup-form');
    const loginUsername = document.getElementById('login-username')
    const loginPassword = document.getElementById('login-password')
    const signupUsername = document.getElementById('signup-username')
    const signupPassword = document.getElementById('signup-password')
    const signupPasswordCheck = document.getElementById('signup-password-check')

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    try{
    const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: loginUsername.value, password: loginPassword.value })
    });

    const data = await res.json();

    if (!res.ok) {
        console.error(data.error || 'Failed to send message');
        return;
    }
    window.location.href = "/";
    }
    catch (err) {
    console.error(err);
    }
  });

  signupForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    try{
    const res = await fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: signupUsername.value, password: signupPassword.value, passwordCheck: signupPasswordCheck.value})
    });

    const data = await res.json();

    if (!res.ok) {
        console.error(data.error || 'Failed to send message');
        return;
    }
    window.location.href = "/";
    }
    catch (err) {
    console.error(err);
    }
  });

</script>
</body>
</html>
