<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.78" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet">
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=delete,attach_file,edit,send,logout,palette,reply,login" />
    <title>Welcome to Dreamchat</title>
    <style>
    body {
      background-image: linear-gradient(to top, #09203f 0%, #537895 100%);
      font-family: "Ubuntu", "Vazirmatn", sans-serif;
      color: white;
      justify-content: center;
      align-items: center;
      text-align: center;
      width: 500px;
      margin: auto;
      margin-top: 5px;
    }

    p{
    padding: 10px;
    }

    html {
      height: 100%;
    }

    button {
      font-family: "Ubuntu", sans-serif;
      border: none;
      border-radius: 8px;
      color: #ffffff;
      padding: 10px;
      cursor: pointer;
      transition: transform 0.1s ease, box-shadow 0.1s ease, opacity 0.1s ease;
    }

    button:hover {
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
      transform: translateY(-1px);
    }

    button:active {
      transform: translateY(0) scale(0.96);
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .glass-container {
      background: rgba(0, 0, 0, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 10px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.6);
    }

header{
 display: flex;
 justify-content: space-between;
 align-items: center;
 border-bottom: solid 2px rgba(255, 255, 255, 0.4);
 padding-left: 10px;
  padding-right: 10px;
}

img {
  display: block;
  margin: auto;
 margin-top: 20px;
}

a,
a:link,
a:visited,
a:hover,
a:active,
a:focus {
  color: #fff;
  text-decoration: none;
  background: none;
  border: none;
  outline: none;
  box-shadow: none;
  font-weight: inherit;
  cursor: pointer;
}

    </style>
</head>
<body>
<header class="glass-container">
<h2 id="header-title">Dreamchat</h2>
<form action="/auth">
<button class="glass-container"><a target="__blank"href="https://github.com/Airp333/Dreamchat">Github</a></button>
<button class="glass-container" type="submit" id="login-btn">Login</button>
</form>
</header>
<article class="glass-container">
<img class="glass-container" id="logo" src="https://res.cloudinary.com/pflmvmcr/image/upload/v1789628776/dreamchat-uploads/laohm11xsrnt27zy8l7h.png" width="150px" height="150px" />
<h1>Dreamchat</h1>
<p>  Welcome to Dreamchat, a minimal chatting web app with one public room. Completely open source and produced by hassanware and developed by Airp. Create a account or login to join the fun</p>
</article>
</body>
</html>
