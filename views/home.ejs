<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=0.78">
  <title>Chat</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=delete,attach_file,edit,send,logout,palette,reply" />
  <style>
    body {
      background-image: linear-gradient(to top, #09203f 0%, #537895 100%);
      font-family: "Ubuntu", "Vazirmatn", sans-serif;
      color: #dbdee1;
      margin: 20px;
      justify-content: center;
      align-items: center;
    }

    html {
      height: 100%;
    }

    input {
      font-family: "Ubuntu", sans-serif;
      width: 100%;
      background: #383a40;
      border: 1px solid #26282c;
      padding: 5px;
      color: #dbdee1;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    input:focus {
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.35);
    }

    button {
      font-family: "Ubuntu", sans-serif;
      border: none;
      border-radius: 8px;
      color: #ffffff;
      padding: 10px;
      cursor: pointer;
      transition: transform 0.1s ease, box-shadow 0.1s ease, opacity 0.1s ease;
    }

    button:hover {
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
      transform: translateY(-1px);
    }

    button:active {
      transform: translateY(0) scale(0.96);
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    h2 {
      margin: 0;
      text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
      padding: 16px 20px;
      padding-right: 5px;
    }

    p {
      text-align: center;
      text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
    }

    .glass-container {
      background: rgba(0, 0, 0, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 10px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.6);
    }

    #main {
      width: 100%;
    }

    input::placeholder {
      color: white;
    }

    #form {
      display: flex;
    }

    #messages {
      max-height: 600px;
      overflow-y: auto;
      scroll-behavior: smooth;
      padding: 12px 0;
    }

    #messages::-webkit-scrollbar {
      width: 8px;
    }

    #messages::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 10px;
    }

    #messages::-webkit-scrollbar-thumb {
      background: rgba(125, 125, 125, 0.5);
      border-radius: 4px;
    }

    .message-container {
      display: grid;
      grid-template-columns: auto 1fr auto auto auto auto;
      gap: 10px;
      align-items: center;
      padding: 6px 12px;
      margin: 2px 8px;
      border-radius: 6px;
      font-weight: 400;
      font-size: 15px;
      color: white;
      transition: background 0.1s ease;
    }

    .message-container:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .message-container .username {
      grid-column: 1;
      grid-row: 1;
    }

    .message-container .msg-text {
      grid-column: 2;
      grid-row: 1;
    }

    .message-container .msg-time {
      grid-column: 6;
      justify-self: end;
      font-size: 12px;
      opacity: 0.5;
      margin-left: 8px;
      grid-row: 1;
    }

    .message-container .delete-btn {
      align-self: center;
      grid-column: 3;
      justify-self: end;
      background: rgba(255, 255, 255, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      box-shadow: 2px 2px 5px rgba(255, 255, 255, 0.1);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      padding: 5px;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .message-container .edit-btn {
      align-self: center;
      grid-column: 4;
      justify-self: end;
      background: rgba(255, 255, 255, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      box-shadow: 2px 2px 5px rgba(255, 255, 255, 0.1);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      padding: 5px;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .message-container .reply-btn {
      align-self: center;
      grid-column: 5;
      grid-row: 1;
      justify-self: end;
      background: rgba(255, 255, 255, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      box-shadow: 2px 2px 5px rgba(255, 255, 255, 0.1);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      padding: 5px;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .message-container .delete-btn .material-symbols-outlined,
    .message-container .edit-btn .material-symbols-outlined,
    .message-container .reply-btn .material-symbols-outlined {
      font-size: 18px;
    }

    #title-container {
      display: flex;
    }

    .logout-btn {
      background: rgba(255, 255, 255, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      box-shadow: 2px 2px 5px rgba(255, 255, 255, 0.1);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      padding: 5px;
      width: 36px;
      height: 36px;
      display: flex;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      align-self: center;
    }

    .logout-btn .material-symbols-outlined {
      font-size: 18px;
    }

    .logout-form {
      align-items: center;
      justify-content: center;
      align-self: center;
    }

    .theme-btn {
      position: fixed;
      bottom: 15px;
      left: 15px;
      background: rgba(0, 0, 0, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      padding: 5px;
      width: 55px;
      height: 55px;
      display: flex;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      align-self: center;
    }

    .theme-btn .material-symbols-outlined {
      font-size: 27px;
    }

    .theme-select {
      background: rgba(0, 0, 0, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      display: flex;
      cursor: pointer;
    }

    .color-btn {
      background: rgba(0, 0, 0, 0.1);
      color: white;
      backdrop-filter: blur(10px);
      border-radius: 15px;
      border: solid 1px rgba(255, 255, 255, 0.4);
      text-shadow: 2px 2px 5px rgba(100, 100, 100, 0.5);
      padding: 5px;
      width: 55px;
      height: 55px;
      display: flex;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      align-self: center;
    }

    #reply-preview {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 6px 10px;
        margin-bottom: 6px;
        font-size: 13px;
    }

    #cancel-reply-btn {
        background: none;
        padding: 0 6px;
        border-radius: 4px;
    }

    .message-container .msg-content {
        grid-column: 2;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .reply-quote {
        font-size: 12px;
        opacity: 0.7;
        padding-left: 6px;
        border-left: 2px solid rgba(255, 255, 255, 0.4);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 300px;
    }

    .reply-quote-username {
        font-weight: 500;
    }
  </style>
</head>
<body>
  <div id="main" class="glass-container">
    <div id="title-container" class="glass-container">
      <h2>Dreamchat v1.6</h2>
      <form class="logout-form" action="/logout" method="GET">
        <button class="logout-btn"><span class="material-symbols-outlined">logout</span></button>
      </form>
    </div>

    <div id="messages">
      <% coloredPayam.forEach((payam) => { %>
        <div class="message-container" data-id="<%= payam.id %>" data-username="<%= payam.username %>" data-color="<%= payam.color %>">
          <span class="username" style="color: <%= payam.color %>"><%= payam.username %></span>
            <% if (payam.imageUrl) { %>
            <img class="msg-text" src="<%= payam.imageUrl %>" style="max-width: 200px; max-height: 200px; border-radius: 6px;" />
            <% } else { %>
            <div class="msg-content">
                <% if (payam.replyToUsername) { %>
                <div class="reply-quote"><span class="reply-quote-username"><%= payam.replyToUsername %></span>: <%= payam.replyToText %></div>
                <% } %>
                <span class="msg-text"><%= payam.text %></span>
            </div>
            <% } %>
          <button class="reply-btn"><span class="material-symbols-outlined">reply</span></button>
          <span class="msg-time"><%= new Date(payam.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
          <% if (payam.username === username) { %>
            <button class="delete-btn"><span class="material-symbols-outlined">delete</span></button>
            <button class="edit-btn"><span class="material-symbols-outlined">edit</span></button>
          <% } %>
        </div>
      <% }) %>
    </div>

    <div id="reply-preview" style="display: none;">
      <span id="reply-preview-text"></span>
      <button type="button" id="cancel-reply-btn">×</button>
    </div>

    <form id="form">
      <input id="input" type="text" placeholder="Type a message..." class="glass-container">
      <button type="submit" class="glass-container">
        <span class="material-symbols-outlined">send</span>
      </button>
      <button id="attach-btn" type="button" class="glass-container">
        <span class="material-symbols-outlined">attach_file</span>
      </button>
      <input id="file-input" style="display: none" type="file" accept="image/*">
    </form>
  </div>

  <div class="theme-container">
    <button class="theme-btn"><span class="material-symbols-outlined">palette</span></button>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const form = document.getElementById('form');
    const input = document.getElementById('input');
    const messages = document.getElementById('messages');
    const username = "<%= username %>";
    const attachBtn = document.getElementById('attach-btn');
    const fileInput = document.getElementById('file-input');
    let activeReply = null;
    const replyPreview = document.getElementById('reply-preview');
    const replyPreviewText = document.getElementById('reply-preview-text');
    const cancelReplyBtn = document.getElementById('cancel-reply-btn');

    function showReplyPreview() {
    replyPreviewText.textContent = `Replying to ${activeReply.username}: ${activeReply.text}`;
    replyPreview.style.display = 'flex';
    }

    function clearReply() {
    activeReply = null;
    replyPreview.style.display = 'none';
    }

    cancelReplyBtn.addEventListener('click', clearReply);

    function usernameToColor(username) {
      let hash = 0;
      for (let i = 0; i < username.length; i++) {
        hash = username.charCodeAt(i) + ((hash << 5) - hash);
      }
      const hue = Math.abs(hash) % 360;
      return `hsl(${hue}, 70%, 65%)`;
    }

    form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    socket.emit('chatMessage', {
        text,
        replyTo: activeReply ? activeReply.id : null,
        replyToUsername: activeReply ? activeReply.username : null,
        replyToText: activeReply ? activeReply.text : null
    });
    input.value = '';
    input.focus();
    clearReply();
    });

    attachBtn.addEventListener('click', (e) => {
      fileInput.click();
    });

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('image', file);

      try {
        const res = await fetch('/messages/upload', {
          method: 'POST',
          body: formData
        });

        if (!res.ok) {
          const data = await res.json();
          alert(data.error || 'Upload failed');
        }
      } catch (err) {
        console.error(err);
        alert('Something went wrong uploading the image');
      }

      fileInput.value = '';
    });

    socket.on('chat message', (data) => {
      const div = document.createElement('div');
      div.className = 'message-container';
      div.dataset.id = data.id;
      div.dataset.username = data.username;
      div.dataset.color = usernameToColor(data.username);

      const usernameSpan = document.createElement('span');
      usernameSpan.className = 'username';
      usernameSpan.style.color = usernameToColor(data.username);
      usernameSpan.textContent = data.username;
      div.appendChild(usernameSpan);

      if (data.imageUrl) {
        const img = document.createElement('img');
        img.className = 'msg-text';
        img.src = data.imageUrl;
        img.style.maxWidth = '200px';
        img.style.maxHeight = '200px';
        img.style.borderRadius = '6px';
        div.appendChild(img);
    } else {
    const contentDiv = document.createElement('div');
    contentDiv.className = 'msg-content';

    if (data.replyToUsername) {
        const quoteDiv = document.createElement('div');
        quoteDiv.className = 'reply-quote';
        const quoteUser = document.createElement('span');
        quoteUser.className = 'reply-quote-username';
        quoteUser.textContent = data.replyToUsername;
        quoteDiv.appendChild(quoteUser);
        quoteDiv.appendChild(document.createTextNode(': ' + data.replyToText));
        contentDiv.appendChild(quoteDiv);
    }

    const textSpan = document.createElement('span');
    textSpan.className = 'msg-text';
    textSpan.textContent = data.text;
    contentDiv.appendChild(textSpan);

    div.appendChild(contentDiv);
    }

      const timeSpan = document.createElement('span');
      timeSpan.className = 'msg-time';
      timeSpan.textContent = new Date(data.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
      div.appendChild(timeSpan);

      if (data.username === username) {
        const deleteBtn = document.createElement('button');
        deleteBtn.className = 'delete-btn';
        const deleteIcon = document.createElement('span');
        deleteIcon.className = 'material-symbols-outlined';
        deleteIcon.textContent = 'delete';
        deleteBtn.appendChild(deleteIcon);
        div.appendChild(deleteBtn);

        const editBtn = document.createElement('button');
        editBtn.className = 'edit-btn';
        const editIcon = document.createElement('span');
        editIcon.className = 'material-symbols-outlined';
        editIcon.textContent = 'edit';
        editBtn.appendChild(editIcon);
        div.appendChild(editBtn);

      }

    const replyBtn = document.createElement('button');
    replyBtn.className = 'reply-btn';
    const replyIcon = document.createElement('span');
    replyIcon.className = 'material-symbols-outlined';
    replyIcon.textContent = 'reply';
    replyBtn.appendChild(replyIcon);
    div.appendChild(replyBtn);

      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    });

    socket.on('message deleted', (id) => {
      const div = document.querySelector(`[data-id="${id}"]`);
      if (div) div.remove();
    });

    socket.on('message edited', ({ id, text }) => {
      const div = document.querySelector(`[data-id="${id}"]`);
      if (!div) return;
      const textSpan = div.querySelector('.msg-text');
      if (textSpan) {
        textSpan.textContent = text;
      }
    });

    messages.addEventListener('click', (e) => {
      if (e.target.closest('.delete-btn')) {
        const button = e.target.closest('.delete-btn');
        const div = button.closest('div');
        const id = div.dataset.id;
        socket.emit('deleteMessage', id);
        return;
      }

      if (e.target.closest('.edit-btn')) {
        const button = e.target.closest('.edit-btn');
        const div = button.closest('div');
        const id = div.dataset.id;
        const textSpan = div.querySelector('.msg-text');
        const currentText = textSpan ? textSpan.textContent : '';
        const newText = prompt('Edit your message:', currentText);
        if (newText !== null && newText.trim() !== '') {
          socket.emit('editMessage', { id, text: newText.trim() });
        }
        return;
      }

    if (e.target.closest('.reply-btn')) {
        const button = e.target.closest('.reply-btn');
        const div = button.closest('.message-container');
        const textSpan = div.querySelector('.msg-text');
        activeReply = {
            id: div.dataset.id,
            username: div.dataset.username,
            text: textSpan ? textSpan.textContent : ''
        };
        showReplyPreview();
        return;
    }
    });
  </script>

  <script>
    const themeBtn = document.querySelector('.theme-btn');
    const body = document.querySelector('body');

    function getRandomElement(arr) {
      const randomIndex = Math.floor(Math.random() * arr.length);
      return arr[randomIndex];
    }

    const grads = [
      "linear-gradient(to top, #09203f 0%, #537895 100%)",
      "linear-gradient(to right, #434343 0%, black 100%)",
      "linear-gradient(78deg, rgba(102, 0, 0, 1) 0%, rgba(176, 0, 0, 1) 51%, rgba(212, 0, 0, 1) 100%)",
      "linear-gradient(351deg, rgba(7, 46, 0, 1) 0%, rgba(28, 130, 0, 1) 52%, rgba(87, 168, 0, 1) 100%)",
      "linear-gradient(90deg, #2c003e 0%, #1a1a2e 100%)",
      "linear-gradient(135deg, #641e16 0%, #d35400 100%)",
    ];

    themeBtn.addEventListener('click', (e) => {
      const themeContainer = document.querySelector('.theme-container');

      const existing = document.querySelector('.theme-select');
      if (existing) {
        existing.remove();
        return;
      }

      const div = document.createElement('div');
      div.style.height = "55px";
      div.style.width = "260px";
      div.style.position = "fixed";
      div.style.bottom = "15px";
      div.style.left = "70px";
      div.style.display = "flex";
      div.style.alignItems = "center";
      div.style.justifyContent = "center";
      div.style.gap = "10px";
      div.className = "theme-select";
      themeContainer.append(div);

      grads.forEach((grad, i) => {
        const btn = document.createElement('button');
        btn.style.width = "30px";
        btn.style.height = "30px";
        btn.style.borderRadius = "10px";
        btn.style.cursor = "pointer";
        btn.style.background = grad;
        btn.className = "color-btn";
        btn.setAttribute('aria-label', `Theme ${i + 1}`);

        btn.addEventListener('click', () => {
          body.style.background = grad;
        });

        div.append(btn);
      });
    });
  </script>
</body>
</html>
